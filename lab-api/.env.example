# Safe local placeholders only. Do not reuse them outside this synthetic lab.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
JSON_BODY_LIMIT_BYTES=32768
JWT_SECRET=replace-me
JWT_ISSUER=company-security-lab
JWT_AUDIENCE=company-security-lab-clients
JWT_TTL_SECONDS=900
RESET_TOKEN_TTL_SECONDS=900
SYNTHETIC_WEBHOOK_SECRET=replace-me-with-local-synthetic-webhook-secret
AI_SOURCE_ALLOWED_HOSTS=content.example.test
# Optional. If omitted, the lab uses a dedicated directory below os.tmpdir().
# UPLOAD_STORAGE_ROOT=/absolute/path/under/the/platform-temp-directory

# Test support is disabled by default. If enabled, use a local synthetic key
# of at least 16 characters and keep the service bound to loopback.
LAB_TEST_MODE=false
LAB_TEST_KEY=
