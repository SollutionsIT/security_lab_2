# Safe synthetic values only. Copy to tests/security/.env and keep both lab
# services bound to loopback. The LAB_TEST_KEY and webhook secret must match
# the values used to start lab-api.
SECURITY_TEST_BASE_URL=http://127.0.0.1:3001
SECURITY_TEST_LAB_TEST_KEY=local-test-key-long-enough
SECURITY_TEST_WEBHOOK_SECRET=whsec_synthetic_local_only_do_not_reuse
SECURITY_TEST_JWT_SECRET=local-synthetic-jwt-secret-32-bytes-min
SECURITY_TEST_JWT_ISSUER=company-security-lab
SECURITY_TEST_JWT_AUDIENCE=company-security-lab-clients
SECURITY_TEST_AI_ALLOWED_SOURCE_URL=https://content.example.test/document/1

SECURITY_TEST_USER_A_EMAIL=alice@example.test
SECURITY_TEST_USER_A_PASSWORD=Alice-Local-Only!42
SECURITY_TEST_USER_B_EMAIL=bob@example.test
SECURITY_TEST_USER_B_PASSWORD=Bob-Local-Only!42
SECURITY_TEST_ADMIN_EMAIL=admin@example.test
SECURITY_TEST_ADMIN_PASSWORD=Admin-Local-Only!42
SECURITY_TEST_UNKNOWN_EMAIL=unknown@example.test
SECURITY_TEST_REPLACEMENT_PASSWORD=Replacement-Local!84

SECURITY_TEST_REQUEST_TIMEOUT_SECONDS=5
